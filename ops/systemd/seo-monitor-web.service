[Unit]
Description=AMS SEO Monitor web application
After=network-online.target postgresql@18-main.service
Wants=network-online.target
Requires=postgresql@18-main.service

[Service]
Type=simple
User=amsplatform
Group=www-data
WorkingDirectory=/opt/ams-platform/ams-seo-monitor/current
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
EnvironmentFile=/etc/ams-platform/ams-seo-monitor.env
ExecStart=/opt/ams-platform/ams-seo-monitor/shared/runtime/current/bin/node /opt/ams-platform/ams-seo-monitor/current/.next/standalone/server.js
Restart=always
RestartSec=5
TimeoutStartSec=5min
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/ams-platform/ams-seo-monitor/shared
