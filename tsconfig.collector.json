{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "dist-collector",
    "rootDir": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "types": ["node"],
    "jsx": "react-jsx",
    "incremental": false,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["collector/**/*.ts", "src/shared/schemas/**/*.ts"],
  "exclude": ["node_modules", "tests", ".next", "dist-collector"]
}
