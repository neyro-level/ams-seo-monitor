{
  "name": "ams-seo-monitor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=11.5.1 <12"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "start": "node .next/standalone/server.js",
    "build": "pnpm verify:config && next build",
    "build:collector": "tsc -p tsconfig.collector.json",
    "release:build": "pnpm build && pnpm build:collector && node scripts/build-release.mjs",
    "release:deploy": "node scripts/deploy-production.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.collector.json",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed-database.ts",
    "user:create": "tsx scripts/auth-admin.ts create",
    "user:disable": "tsx scripts/auth-admin.ts disable",
    "user:set-system-role": "tsx scripts/auth-admin.ts set-system-role",
    "user:add-to-organization": "tsx scripts/auth-admin.ts add-to-organization",
    "user:remove-from-organization": "tsx scripts/auth-admin.ts remove-from-organization",
    "verify:config": "node scripts/verify-config.mjs",
    "verify:snapshots": "node scripts/verify-snapshots.mjs",
    "db:restore-smoke": "node scripts/db-restore-smoke.mjs",
    "project:add": "node scripts/project-add.mjs",
    "collector:webmaster:preflight": "pnpm build:collector && node dist-collector/collector/main.js webmaster-preflight",
    "collector:webmaster:audit": "pnpm build:collector && node dist-collector/collector/main.js webmaster-audit",
    "collector:metrica:preflight": "pnpm build:collector && node dist-collector/collector/main.js metrica-preflight",
    "collector:metrica:audit": "pnpm build:collector && node dist-collector/collector/main.js metrica-audit",
    "collector:sync:REDACTED_CLIENT_DATA": "pnpm build:collector && node dist-collector/collector/main.js client-sync REDACTED_CLIENT_DATA",
    "worker:sync:project": "pnpm build:collector && node dist-collector/src/worker/main.js project-sync",
    "worker:sync:REDACTED_CLIENT_DATA": "pnpm build:collector && node dist-collector/src/worker/main.js project-sync REDACTED_CLIENT_DATA"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "1.7.2",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.2",
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
