{
  "name": "ams-seo-monitor",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=11.5.1 <12"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3000",
    "start": "next start --hostname 127.0.0.1 --port 3000",
    "dev:live": "node scripts/dev-live.mjs",
    "dev:reports": "node scripts/serve-local-reports.mjs",
    "build": "pnpm verify:config && next build",
    "build:collector": "tsc -p tsconfig.collector.json",
    "release:build": "pnpm build && pnpm build:collector && node scripts/build-release.mjs",
    "release:deploy": "node scripts/deploy-production.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.collector.json",
    "test": "vitest run",
    "verify:config": "node scripts/verify-config.mjs",
    "verify:snapshots": "node scripts/verify-snapshots.mjs",
    "project:add": "node scripts/project-add.mjs",
    "collector:webmaster:preflight": "pnpm build:collector && node dist-collector/collector/main.js webmaster-preflight",
    "collector:webmaster:audit": "pnpm build:collector && node dist-collector/collector/main.js webmaster-audit",
    "collector:metrica:preflight": "pnpm build:collector && node dist-collector/collector/main.js metrica-preflight",
    "collector:metrica:audit": "pnpm build:collector && node dist-collector/collector/main.js metrica-audit",
    "collector:sync:REDACTED_CLIENT_DATA": "pnpm build:collector && node dist-collector/collector/main.js client-sync REDACTED_CLIENT_DATA"
  },
  "dependencies": {
    "lucide-react": "1.37.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
